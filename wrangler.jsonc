{
	"name": "nozodev",
	"compatibility_date": "2026-01-31",
	"assets": {
		"directory": "./out",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	},
	"env": {
		"preview": {
			"vars": {
				"DEPLOY_ENV": "preview"
			}
		},
		"production": {
			"vars": {
				"DEPLOY_ENV": "production"
			},
			"name": "nozodev"
		}
	}
}
