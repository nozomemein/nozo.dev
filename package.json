{
	"name": "portfolio",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "void prepare && vp dev",
		"build": "bun run fetch:link-previews && void prepare && vp build && bun scripts/build-static.ts",
		"analyze": "void prepare && vp build --sourcemap",
		"fetch:link-previews": "bun scripts/fetch-link-previews.ts",
		"start": "wrangler dev --config .void-wrangler.jsonc --assets out --port 3000",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"check:write": "biome check --write .",
		"test": "bun test",
		"clean": "rm -rf dist out .void .wrangler .void-wrangler.jsonc",
		"typecheck": "void prepare && tsc --noEmit"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@mdx-js/react": "^3.1.1",
		"@radix-ui/react-dropdown-menu": "^2.1.18",
		"@radix-ui/react-slot": "^1.2.5",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"gray-matter": "^4.0.3",
		"hono": "4.13.13",
		"lucide-react": "^1.18.0",
		"next-themes": "^0.4.6",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"rehype-pretty-code": "^0.14.3",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-mdx-frontmatter": "^5.2.0",
		"tailwind-merge": "^3.6.0",
		"wrangler": "^4.100.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@mdx-js/rollup": "3.1.1",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/postcss": "^4.3.1",
		"@types/bun": "^1.4.3",
		"@types/mdx": "^2.0.14",
		"@types/node": "^26.0.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@void/react": "0.27.0",
		"cheerio": "^1.1.2",
		"lefthook": "^2.1.9",
		"postcss": "^8.5.15",
		"satori": "^0.52.0",
		"tailwindcss": "^4.3.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
		"vite-plus": "1.1.0",
		"void": "0.27.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
	},
	"engines": {
		"node": ">=24.21.0"
	},
	"type": "module",
	"packageManager": "bun@1.3.14"
}
